--synthesis_resources = lut 8 
SUBDESIGN decode_cla
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[6..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[6..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode2075w[3..0]	: WIRE;
	w_anode2092w[3..0]	: WIRE;
	w_anode2102w[3..0]	: WIRE;
	w_anode2112w[3..0]	: WIRE;
	w_anode2122w[3..0]	: WIRE;
	w_anode2132w[3..0]	: WIRE;
	w_anode2142w[3..0]	: WIRE;
	w_anode2152w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[6..0] = eq_wire[6..0];
	eq_wire[] = ( w_anode2152w[3..3], w_anode2142w[3..3], w_anode2132w[3..3], w_anode2122w[3..3], w_anode2112w[3..3], w_anode2102w[3..3], w_anode2092w[3..3], w_anode2075w[3..3]);
	w_anode2075w[] = ( (w_anode2075w[2..2] & (! data_wire[2..2])), (w_anode2075w[1..1] & (! data_wire[1..1])), (w_anode2075w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2092w[] = ( (w_anode2092w[2..2] & (! data_wire[2..2])), (w_anode2092w[1..1] & (! data_wire[1..1])), (w_anode2092w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2102w[] = ( (w_anode2102w[2..2] & (! data_wire[2..2])), (w_anode2102w[1..1] & data_wire[1..1]), (w_anode2102w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2112w[] = ( (w_anode2112w[2..2] & (! data_wire[2..2])), (w_anode2112w[1..1] & data_wire[1..1]), (w_anode2112w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2122w[] = ( (w_anode2122w[2..2] & data_wire[2..2]), (w_anode2122w[1..1] & (! data_wire[1..1])), (w_anode2122w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2132w[] = ( (w_anode2132w[2..2] & data_wire[2..2]), (w_anode2132w[1..1] & (! data_wire[1..1])), (w_anode2132w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2142w[] = ( (w_anode2142w[2..2] & data_wire[2..2]), (w_anode2142w[1..1] & data_wire[1..1]), (w_anode2142w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2152w[] = ( (w_anode2152w[2..2] & data_wire[2..2]), (w_anode2152w[1..1] & data_wire[1..1]), (w_anode2152w[0..0] & data_wire[0..0]), enable_wire);
END;
