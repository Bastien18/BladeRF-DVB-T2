FUNCTION cyclonev_clkena (ena, inclk)
WITH ( clock_type, disable_mode, ena_register_mode, ena_register_power_up, test_syn)
RETURNS ( enaout, outclk);

--synthesis_resources = cyclonev_clkena 1 
SUBDESIGN altclkctrl_h9i
( 
	ena	:	input;
	inclk[0..0]	:	input;
	outclk	:	output;
) 
VARIABLE 
	sd1 : cyclonev_clkena
		WITH (
			clock_type = "Auto",
			ena_register_mode = "none"
		);
	clkselect[1..0]	: NODE;

BEGIN 
	sd1.ena = ena;
	sd1.inclk = inclk[0..0];
	clkselect[] = GND;
	outclk = sd1.outclk;
END;
--VALID FILE
